rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User Profiles
    match /users/{userId} {
      function isValidUser(data) {
        let isSystemAdmin = request.auth.token.email == 'allyonasmedia@gmail.com';
        return data.name is string && data.name.size() > 0 && data.name.size() < 100
            && data.email is string && data.email == request.auth.token.email
            && (data.role == (isSystemAdmin ? 'admin' : data.role in ['user', 'organizer'] ? data.role : 'user'));
      }
      function canUpdateUser(incoming, existing) {
        let isSystemAdmin = request.auth.token.email == 'allyonasmedia@gmail.com';
        let allowedKeys = isSystemAdmin ? ['name', 'phone', 'role', 'updatedAt'] : ['name', 'phone', 'updatedAt'];
        return incoming.diff(existing).affectedKeys().hasOnly(allowedKeys);
      }
      allow get: if isOwner(userId);
      allow list: if false; 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && canUpdateUser(incoming(), existing());
    }

    // Events
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.title is string && data.title.size() > 0
            && data.organizerId == request.auth.uid
            && data.status in ['draft', 'published', 'cancelled'];
      }
      allow read: if incoming() == null || incoming().status == 'published' || isOwner(existing().organizerId);
      allow list: if true; // Listing is OK with query filters (status='published')
      allow create: if isSignedIn() && isValidEvent(incoming());
      allow update: if isOwner(existing().organizerId) && isValidEvent(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'dateTime', 'bannerUrl', 'category', 'status']);

      // Ticket Types (Subcollection)
      match /ticketTypes/{typeId} {
        function isValidTicketType(data) {
          return data.name is string && data.price is number && data.price >= 0
              && data.quantityTotal is number && data.quantityTotal > 0;
        }
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId);
      }
    }

    // Bookings
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.userId == request.auth.uid
            && data.eventId is string
            && data.status in ['pending', 'confirmed', 'failed'];
      }
      allow get: if isSignedIn() && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/events/$(existing().eventId)).data.organizerId));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        (isOwner(get(/databases/$(database)/documents/events/$(existing().eventId)).data.organizerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }

    // Tickets
    match /tickets/{ticketId} {
      function isValidTicket(data) {
        return data.userId is string && data.eventId is string && data.status in ['valid', 'used', 'refunded'];
      }
      allow get: if isSignedIn() && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/events/$(existing().eventId)).data.organizerId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId));
      allow create: if false; // Tickets should be created via admin/server or complex transaction (but for MVP we might allow if booking matches)
      allow update: if isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(existing().eventId)).data.organizerId)
                   && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scannedAt', 'scannedBy']);
    }
  }
}
