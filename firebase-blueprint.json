{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Additional user information beyond Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "organizer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "Event": {
      "title": "Event",
      "description": "Event details created by organizers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "organizerId": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "location", "dateTime", "organizerId"]
    },
    "TicketType": {
      "title": "Ticket Type",
      "description": "Definition of a ticket category for an event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantityTotal": { "type": "number" },
        "quantitySold": { "type": "number" }
      },
      "required": ["eventId", "name", "price", "quantityTotal"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A user's transaction for tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "failed"] },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventId", "status", "totalAmount"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "An individual digital ticket for an attendee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "eventId": { "type": "string" },
        "ticketTypeId": { "type": "string" },
        "userId": { "type": "string" },
        "qrCode": { "type": "string" },
        "status": { "type": "string", "enum": ["valid", "used", "refunded"] },
        "scannedAt": { "type": "string", "format": "date-time" },
        "scannedBy": { "type": "string" }
      },
      "required": ["bookingId", "eventId", "ticketTypeId", "userId", "qrCode", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "events/{eventId}": {
      "schema": "Event",
      "description": "Event documents"
    },
    "events/{eventId}/ticketTypes/{typeId}": {
      "schema": "TicketType",
      "description": "Ticket types for a specific event"
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Booking documents"
    },
    "tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Individual ticket documents"
    }
  }
}
